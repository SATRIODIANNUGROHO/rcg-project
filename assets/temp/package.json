{
  "name": "pt-reka-cipta-garam",
  "productName": "RCG Salt Weighing System",
  "version": "7.5.0",
  "description": "Salt Weighing System",
  "author": "PT. Reka Cipta Garam",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.rcg.sws",
    "artifactName": "${productName} Setup ${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "RCG SWS.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Salt Weighing System"
    }
  },
  "dependencies": {
    "@fontsource/lexend": "^5.3.0",
    "@serialport/parser-readline": "^13.0.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "serialport": "^13.0.0"
  }
}
